# BigWigsMods/packager config. Publishing is off until the Wago / CurseForge projects exist (see release.yml).
package-as: FloorIsLava

ignore:
  - tests
  - tools
  - .luacheckrc
  - media/icon.png
  - media/logo.png
  - media/screenshots

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
